<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan: the compositor and the window run on wgpu's Vulkan backend. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- No storage permissions: files come and go through the system document picker. -->

    <application
        android:label="EffectCraft"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:largeHeap="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.EffectCraft">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|navigation|colorMode|fontScale|locale|layoutDirection">

            <meta-data android:name="android.app.lib_name" android:value="effectcraft_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
